# ============================================
# .gitignore для репозитория 3D-моделей
# ============================================

# --- Специфичные для КОМПАС-3D ---
# Основные рабочие файлы (чертежи, фрагменты, спецификации, сборки, детали)
*.cdw
*.frw
*.spw
*.kdw
# Резервные копии и временные файлы КОМПАС
*.FCBak
*.bak
*.tmp

# --- Специфичные для Bambu Studio и 3D-печати ---
# Готовые к печати файлы (G-code, 3MF-проекты)
*.gcode
*.bgcode
# Временные файлы слайсера
*.3mf.tmp
result.json

# --- Общие форматы 3D-моделей и CAD ---
# Полигональные и сеточные модели
*.obj
*.ply
*.glb
*.gltf
*.3ds
*.amf
# Обменные CAD-форматы (STEP, IGES)
*.iges
*.igs
# Форматы других CAD-систем (SolidWorks и др.)
*.sldprt
*.sldasm
*.slddrw
*.SLDPRT
*.SLDASM
*.SLDDRW
# Файлы Blender, Cinema 4D и подобных
*.blend
*.blend1
*.c4d

# --- Временные и кэш-файлы ---
*cache
*.zip
!*.zip.lfs  # если используете Git LFS, можно оставить исключение

# --- Файлы операционных систем ---
.DS_Store
Thumbs.db
desktop.ini

# --- Файлы IDE и редакторов кода ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Логи и отладочная информация ---
*.log